---
import Bars from "./Bars.astro"
import svgRedStar from '../assets/red-star.svg'
import svgIdea from '../assets/idea.svg'
import svgPinkStar from '../assets/pink-star.svg'
import svgUnderline from '../assets/underline.svg'
import { products } from '../data/products'

const surgeProduct = products.find(p => p.slug === 'surge') || products[0];
---

<section class="pb-16 pt-12 md:pt-20 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4">
    
    <!-- Studio Header Tag -->
    <div class="flex items-center gap-3 mb-6">
      <div class="inline-flex items-center gap-2 bg-black text-white px-3.5 py-1 text-xs font-black uppercase tracking-wider border-2 border-black shadow-[3px_3px_0px_rgba(255,220,88,1)]">
        <span class="w-2 h-2 rounded-full bg-[var(--yellow)] animate-pulse"></span>
        <span>Data Analytics, Intelligence & Software Studio</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[65%_35%] gap-8 items-center">
      
      <!-- Left Hero Headline -->
      <div class="flex flex-col gap-6">
        <div>
          <h1 class="text-4xl md:text-6xl font-black leading-tight tracking-tight">
            <span>Market Intelligence,</span><br>
            <span class="relative inline-block mt-1">
              <span class="absolute bg-[var(--yellow)] w-full h-[45%] left-0 bottom-1 z-0"></span>
              <span class="relative z-10">Data Analytics & Strategy</span>
            </span>
          </h1>
          <img src={svgUnderline.src} alt="" width="240" class="mt-2" />
        </div>

        <p class="text-lg md:text-xl text-neutral-800 leading-relaxed font-normal">
          We engineer automated data harvesting pipelines, predictive market analytics, talent intelligence feeds, and scalable full-stack web platforms.
        </p>

        <!-- Studio Quick Stats -->
        <div class="grid grid-cols-3 gap-3 pt-1">
          <div class="bg-white border-2 border-black p-3 shadow-[3px_3px_0px_rgba(0,0,0,1)]">
            <span class="text-2xl font-black block">90+</span>
            <span class="text-[11px] uppercase font-bold text-neutral-600">Tracked Companies</span>
          </div>
          <div class="bg-white border-2 border-black p-3 shadow-[3px_3px_0px_rgba(0,0,0,1)]">
            <span class="text-2xl font-black block text-emerald-700">100%</span>
            <span class="text-[11px] uppercase font-bold text-neutral-600">Direct ATS Verified</span>
          </div>
          <div class="bg-white border-2 border-black p-3 shadow-[3px_3px_0px_rgba(0,0,0,1)]">
            <span class="text-2xl font-black block">500+</span>
            <span class="text-[11px] uppercase font-bold text-neutral-600">Active Web Users</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a 
            href="/products/surge" 
            class="bg-[var(--yellow)] hover:bg-[#ffe37d] text-black text-base font-bold px-7 py-3.5 border-3 border-black shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_rgba(0,0,0,1)] transition-all flex items-center gap-2">
            <span>Explore Surge Report 🔥</span>
            <i class="ri-arrow-right-line font-bold"></i>
          </a>

          <a 
            href="/products" 
            class="bg-white hover:bg-neutral-50 text-black text-sm font-bold px-5 py-3.5 border-2 border-black shadow-[3px_3px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_rgba(0,0,0,1)] transition-all flex items-center gap-2">
            <span>All Products & Feeds</span>
          </a>
        </div>
      </div>

      <!-- Right Card Graphic -->
      <div class="relative mt-6 lg:mt-0">
        <img src={svgRedStar.src} width="60" alt="" class="absolute -top-7 -right-3 z-10 hidden sm:block" />
        <img src={svgIdea.src} width="45" alt="" class="absolute -bottom-5 -left-3 z-10 hidden sm:block" />

        <div class="bg-white border-3 border-black p-6 shadow-[8px_8px_0px_rgba(0,0,0,1)] relative space-y-3.5">
          <div class="flex items-center justify-between border-b-2 border-black pb-2.5">
            <span class="font-bold text-xs tracking-wider uppercase bg-black text-white px-2 py-0.5">Studio Core</span>
            <span class="text-xs font-mono font-bold text-neutral-500">EST. 2026</span>
          </div>

          <div class="space-y-2.5 text-xs">
            <div class="p-2.5 bg-[#FEFFF0] border-2 border-black">
              <span class="font-black text-xs block mb-0.5 uppercase">01 // B2B Intelligence Feeds</span>
              <p class="text-neutral-600">Weekly engineering hiring spikes & raw ATS datasets.</p>
            </div>
            <div class="p-2.5 bg-white border-2 border-black">
              <span class="font-black text-xs block mb-0.5 uppercase">02 // Data Analytics & Strategy</span>
              <p class="text-neutral-600">Talent velocity scoring, salary benchmarking & market signals.</p>
            </div>
            <div class="p-2.5 bg-white border-2 border-black">
              <span class="font-black text-xs block mb-0.5 uppercase">03 // Data Analytics & Dashboards</span>
              <p class="text-neutral-600">Interactive exploratory analytics, financial models & reporting tools.</p>
            </div>
            <div class="p-2.5 bg-white border-2 border-black">
              <span class="font-black text-xs block mb-0.5 uppercase">04 // Custom Crawler Pipelines</span>
              <p class="text-neutral-600">Dedicated scraping pipelines with scheduled automated outputs.</p>
            </div>
          </div>

          <div class="pt-1">
            <Bars />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
