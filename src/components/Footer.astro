---
import logoStar from '../assets/logo-star.svg'
import { author } from '../sample'
---

<footer class="border-t-4 bg-white px-6 md:px-10 py-12 mt-20">
  <div class="max-w-5xl mx-auto space-y-8">
    
    <!-- Top Row: Brand & Links Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-1 space-y-3">
        <a href="/" class="flex items-center gap-2 text-xl font-bold">
          <img src={logoStar.src} alt="logo" width="28" />
          <span>{author.nickname}</span>
        </a>
        <p class="text-xs text-neutral-600 leading-relaxed">
          Independent Data & Software Studio engineering automated B2B intelligence feeds, market analytics, and modern web applications.
        </p>
        <div class="text-[11px] font-mono text-neutral-500">
          📍 {author.location}
        </div>
      </div>

      <!-- Column 1: Data Feeds & Products -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-black uppercase tracking-wider text-black border-b-2 border-black pb-1">
          Data Products
        </h4>
        <ul class="space-y-1.5 text-xs font-bold text-neutral-700">
          <li><a href="/products/surge" class="hover:underline hover:text-black">Surge Report 🔥</a></li>
          <li><a href="/products" class="hover:underline hover:text-black">Products Catalog</a></li>
          <li><a href="/contact" class="hover:underline hover:text-black">Custom Scraping Feeds</a></li>
        </ul>
      </div>

      <!-- Column 2: Studio & Engineering -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-black uppercase tracking-wider text-black border-b-2 border-black pb-1">
          Studio & Creator
        </h4>
        <ul class="space-y-1.5 text-xs font-bold text-neutral-700">
          <li><a href="/profile" class="hover:underline hover:text-black">Developer Profile & Resume</a></li>
          <li><a href="/profile#work" class="hover:underline hover:text-black">Software Projects</a></li>
          <li><a href="https://blog.jayasurya.digital" target="_blank" rel="noreferrer" class="hover:underline hover:text-black">Engineering Blog ↗</a></li>
          <li><a href="/contact" class="hover:underline hover:text-black">Contact & Inquiries</a></li>
        </ul>
      </div>

      <!-- Column 3: Legal & Compliance -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-black uppercase tracking-wider text-black border-b-2 border-black pb-1">
          Legal & Trust
        </h4>
        <ul class="space-y-1.5 text-xs font-bold text-neutral-700">
          <li><a href="/privacy" class="hover:underline hover:text-black">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:underline hover:text-black">Terms of Service</a></li>
          <li><a href="mailto:suryasunrise261@gmail.com" class="hover:underline hover:text-black">Support: {author.email}</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Row: Copyright & Payment Security -->
    <div class="pt-6 border-t-2 border-neutral-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-neutral-500">
      <div>
        © {new Date().getFullYear()} {author.name}. All rights reserved. Payments secured by Dodo Payments.
      </div>
      <div class="flex items-center gap-4 font-bold text-neutral-700">
        <a href={author.LinkedIn} target="_blank" rel="noreferrer" class="hover:underline">LinkedIn</a>
        <a href="https://github.com/jayasurya261" target="_blank" rel="noreferrer" class="hover:underline">GitHub</a>
        <a href={`mailto:${author.email}`} class="hover:underline">Email</a>
      </div>
    </div>

  </div>
</footer>
