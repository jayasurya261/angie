---
import Bars from "./Bars.astro"
import svgUnderline from '../assets/underline.svg'
import svgRedStar from '../assets/red-star.svg'
import { products } from '../data/products'
import { lastUpdatedDate } from '../data/surge-sample'

const surgeProduct = products.find(p => p.slug === 'surge') || products[0];
---

<section class="py-14 px-4 relative z-10" id="data-studio">
  <div class="max-w-4xl mx-auto">
    
    <!-- Top Announcement Tag -->
    <div class="flex items-center justify-between mb-4">
      <div class="inline-flex items-center gap-2 bg-black text-white px-3 py-1 text-xs font-black uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-[var(--yellow)] animate-ping"></span>
        <span>Independent Data Studio</span>
      </div>
      <span class="text-xs font-bold text-neutral-600 hidden sm:inline-block">
        Freshness: {lastUpdatedDate}
      </span>
    </div>

    <!-- Main Studio Box -->
    <div class="bg-white border-3 border-black p-6 md:p-8 shadow-[8px_8px_0px_rgba(0,0,0,1)] relative">
      <img src={svgRedStar.src} alt="" width="60" class="absolute -top-7 -right-4 hidden sm:block" />

      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        
        <div class="space-y-3 max-w-xl">
          <div class="flex items-center gap-2">
            <span class="bg-[var(--yellow)] text-black text-xs font-black px-2 py-0.5 border border-black uppercase">
              Flagship Intelligence Report
            </span>
            <span class="text-xs font-mono font-bold text-neutral-500">// B2B INTEL FEED</span>
          </div>

          <h2 class="text-2xl md:text-3xl font-black leading-snug">
            Engineering Hiring Surge Report
          </h2>

          <p class="text-neutral-700 text-sm md:text-base leading-relaxed">
            I build independent market & talent data products. The flagship weekly intelligence report tracks sudden engineering hiring spikes across <strong>90+ high-growth tech companies</strong> with verified ATS endpoints, salary data, and zero ghost jobs.
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-1 text-xs font-bold">
            <span class="bg-neutral-100 border border-black px-2 py-1">Weekly Monday Delivery</span>
            <span class="bg-neutral-100 border border-black px-2 py-1">CSV + Email Briefing</span>
            <span class="bg-[var(--blue)] border border-black px-2 py-1">$49 / month</span>
          </div>
        </div>

        <!-- Right Action Column -->
        <div class="flex flex-col gap-3 w-full md:w-auto shrink-0">
          <a 
            href="/products/surge" 
            class="bg-[var(--yellow)] hover:bg-[#ffe37d] text-black font-black text-base px-6 py-3.5 border-2 border-black shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-center gap-2 text-center">
            <span>Explore Surge Report</span>
            <i class="ri-arrow-right-line font-bold"></i>
          </a>

          <a 
            href="/products" 
            class="bg-white hover:bg-neutral-100 text-black font-bold text-xs px-4 py-2.5 border border-black text-center transition-all">
            View All Data Products →
          </a>
        </div>

      </div>

      <div class="mt-6 pt-3 border-t-2 border-black flex justify-between items-center text-xs text-neutral-500">
        <span>One crawler pipeline · verified ATS data · many reports</span>
        <Bars />
      </div>

    </div>

  </div>
</section>
