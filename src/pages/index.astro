---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro"
import Header from '../components/Header.astro'
import StudioHero from '../components/StudioHero.astro'
import Footer from '../components/Footer.astro'
import svgUnderline from '../assets/underline.svg'
import svgRedStar from '../assets/red-star.svg'
import svgPinkStar from '../assets/pink-star.svg'
import { products } from '../data/products'

const surgeProduct = products.find(p => p.slug === 'surge') || products[0];

const pageTitle = "Jayasurya Studio | Data Analytics, Intelligence Products & Engineering";
const pageDesc = "Independent Data & Software Studio. We engineer automated B2B market intelligence feeds, talent analytics, data strategy, and scalable full-stack web platforms.";

const featuredWorks = [
  { 
    name: 'DataRupee', 
    desc: 'Finance & analytics platform engineered for tracking market metrics, structured data presentation, and actionable financial insights.',
    cover: '/image.png',
    link: 'https://datarupee.space'
  },
  { 
    name: 'Codesapiens Management Portal', 
    desc: 'Full-stack institute management & analytics platform built with React, Node.js, and MongoDB, actively serving 500+ users.',
    cover: 'https://axvfpbdzas50.objectstorage.ap-hyderabad-1.oci.customer-oci.com/n/axvfpbdzas50/b/surya/o/codesapiens-website-home-pageScreenshot%202025-10-12%20124305.png',
    link: 'https://www.codesapiens.in'
  },
  { 
    name: 'RepoWave - Open Source Finder', 
    desc: 'Open-source issue discovery & data filtering dashboard with tech-stack indexing and automated issue detection.',
    cover: 'https://res.cloudinary.com/dqudvximt/image/upload/v1773309490/Screenshot_2026-03-12_152731_lyk6jq.png',
    link: 'https://repowave.space'
  },
];
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />

  <!-- 1. Generalized Studio Hero -->
  <StudioHero />

  <!-- 2. Core Studio Pillars: Intelligence, Analytics, Strategy, Engineering -->
  <section class="py-16 px-4 bg-[#f8f9eb] border-y-3 border-black">
    <div class="max-w-5xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-block bg-[var(--yellow)] px-3 py-1 text-xs font-black uppercase border-2 border-black mb-3">
          Capabilities & Solutions
        </div>
        <h2 class="text-3xl md:text-5xl font-black">Data Analytics, Strategy & Engineering</h2>
        <p class="text-neutral-700 mt-2 text-md">
          Transforming unstructured web data into verified market intelligence and high-performance software systems.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="bg-white border-3 border-black p-5 shadow-[5px_5px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-[var(--yellow)] border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-radar-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">B2B Market Intelligence</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Automated data products tracking sudden engineering hiring spikes, headcount expansion, and verified opening feeds across 90+ companies.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200">
            <a href="/products/surge" class="text-xs font-bold underline flex items-center gap-1 hover:text-neutral-700">
              <span>Surge Report ($49/mo)</span>
              <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </div>

        <div class="bg-white border-3 border-black p-5 shadow-[5px_5px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-emerald-200 border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-line-chart-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">Data Analytics & Benchmarks</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Compensation distribution modeling, talent velocity indicators, and normalized salary analytics across remote hubs and disciplines.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200">
            <a href="/products" class="text-xs font-bold underline flex items-center gap-1 hover:text-neutral-700">
              <span>Explore Benchmarks</span>
              <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </div>

        <div class="bg-white border-3 border-black p-5 shadow-[5px_5px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-[var(--blue)] border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-pie-chart-2-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">Data Strategy & Advisory</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Helping staffing firms, sourcers, and funds architect custom data extraction workflows, competitor talent mapping, and CRM pipelines.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200">
            <a href="mailto:suryasunrise261@gmail.com?subject=Data%20Strategy%20Inquiry" class="text-xs font-bold underline flex items-center gap-1 hover:text-neutral-700">
              <span>Inquire Strategy</span>
              <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </div>

        <div class="bg-white border-3 border-black p-5 shadow-[5px_5px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-purple-200 border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-bar-chart-grouped-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">Data Analytics & Dashboards</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Exploratory data analysis, interactive metrics dashboards, and visual intelligence to transform raw data streams into high-conviction decisions.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200">
            <a href="/products" class="text-xs font-bold underline flex items-center gap-1 hover:text-neutral-700">
              <span>Explore Analytics Feeds</span>
              <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. Featured Flagship Product Spotlight -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      
      <div class="flex items-center justify-between mb-4">
        <div class="inline-flex items-center gap-2 bg-black text-white px-3 py-1 text-xs font-black uppercase">
          <span class="w-2 h-2 rounded-full bg-[var(--yellow)] animate-pulse"></span>
          <span>Flagship Data Intelligence</span>
        </div>
        <a href="/products" class="text-xs font-bold underline">View All Data Products →</a>
      </div>

      <div class="bg-white border-3 border-black p-6 md:p-10 shadow-[8px_8px_0px_rgba(0,0,0,1)] relative">
        <img src={svgRedStar.src} alt="" width="65" class="absolute -top-7 -right-4 hidden sm:block" />

        <div class="grid grid-cols-1 lg:grid-cols-[65%_35%] gap-8 items-center">
          
          <div class="space-y-4">
            <div class="inline-block bg-[var(--yellow)] text-black px-2.5 py-0.5 text-xs font-black uppercase border border-black">
              Weekly Intelligence Feed
            </div>
            <h3 class="text-3xl md:text-4xl font-black leading-tight">
              Engineering Hiring Surge Report
            </h3>
            <p class="text-neutral-700 text-sm md:text-base leading-relaxed">
              We continuously monitor <strong>90+ top tech companies</strong> directly across Ashby, Greenhouse, and Lever endpoints to surface sudden engineering team expansion waves and hiring surges every Monday morning.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs font-bold">
              <div class="bg-neutral-100 border border-black p-2.5">
                <span class="block text-neutral-500 text-[10px] uppercase">Frequency</span>
                <span>Monday 8:00 AM UTC</span>
              </div>
              <div class="bg-neutral-100 border border-black p-2.5">
                <span class="block text-neutral-500 text-[10px] uppercase">Format</span>
                <span>CSV + Email Briefing</span>
              </div>
              <div class="bg-emerald-100 border border-black p-2.5 col-span-2 sm:col-span-1">
                <span class="block text-emerald-800 text-[10px] uppercase">Coverage</span>
                <span>100% Direct ATS Feeds</span>
              </div>
            </div>
          </div>

          <!-- Right Action Box -->
          <div class="bg-[#FEFFF0] border-2 border-black p-6 flex flex-col justify-between shadow-[4px_4px_0px_rgba(0,0,0,1)] text-center">
            <div>
              <span class="text-xs font-bold uppercase text-neutral-600 block mb-1">Commercial Plan</span>
              <div class="text-4xl font-black">${surgeProduct.price} <span class="text-sm font-normal text-neutral-600">/ month</span></div>
              <p class="text-xs text-neutral-600 mt-2">Zero lock-in. Cancel anytime with 1-click.</p>
            </div>

            <div class="mt-6 space-y-2.5">
              <a 
                href="/products/surge" 
                class="w-full bg-[var(--yellow)] hover:bg-[#ffe37d] text-black font-black text-sm py-3 px-4 border-2 border-black shadow-[3px_3px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-center gap-1.5">
                <span>View Live Table & Subscribe →</span>
              </a>
              <a 
                href="/products/surge#sample-data" 
                class="w-full bg-white hover:bg-neutral-100 text-black font-bold text-xs py-2 px-3 border border-black block transition-all">
                Preview Sample Data (10 Roles)
              </a>
            </div>
          </div>

        </div>

        <div class="mt-6 pt-4 border-t border-neutral-200 flex justify-between items-center text-xs text-neutral-500">
          <span>Dedicated product page: jayasurya.digital/products/surge</span>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. Data Strategy & Analytics Case Studies / Featured Software Works -->
  <section class="py-16 px-4 bg-[#FEFFF0] border-y-3 border-black">
    <div class="max-w-5xl mx-auto">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <div class="inline-block bg-[var(--blue)] px-3 py-1 text-xs font-black uppercase border-2 border-black mb-3">
            Analytics & Software Platforms
          </div>
          <h2 class="text-3xl md:text-5xl font-black">Featured Products & Systems</h2>
          <p class="text-neutral-700 mt-2 text-md">
            Production web platforms and data analytics tooling engineered by the studio.
          </p>
        </div>

        <a 
          href="/profile" 
          class="bg-white hover:bg-neutral-100 text-black font-bold text-sm px-5 py-2.5 border-2 border-black shadow-[3px_3px_0px_rgba(0,0,0,1)] transition-all shrink-0">
          View Full Developer Profile →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredWorks.map(item => (
          <a 
            href={item.link} 
            target="_blank" 
            rel="noreferrer" 
            class="bg-white border-3 border-black p-5 shadow-[5px_5px_0px_rgba(0,0,0,1)] flex flex-col justify-between group hover:shadow-[7px_7px_0px_rgba(0,0,0,1)] transition-all">
            <div>
              <div class="w-full h-[160px] overflow-hidden border-2 border-black mb-4 bg-neutral-100">
                <img src={item.cover} alt={item.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              </div>
              <h3 class="font-black text-lg mb-1.5">{item.name}</h3>
              <p class="text-xs text-neutral-700 leading-relaxed mb-4">{item.desc}</p>
            </div>
            <div class="pt-3 border-t border-neutral-200 text-xs font-bold text-black flex items-center justify-between">
              <span>Visit Live Platform</span>
              <i class="ri-arrow-right-up-line"></i>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. Data Analytics & Pipeline Strategy -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-block bg-[var(--yellow)] px-3 py-1 text-xs font-black uppercase border-2 border-black mb-3">
          Architecture & Analytics Flow
        </div>
        <h2 class="text-3xl md:text-5xl font-black">How the Analytics Engine Operates</h2>
        <p class="text-neutral-700 mt-2 text-md">
          A continuous, resilient data pipeline running automated scrapers, data models, and predictive velocity analytics.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
          <div class="font-mono text-xs font-black bg-black text-white px-2 py-0.5 inline-block mb-3">01 // HARVEST</div>
          <h4 class="font-black text-base mb-1">Direct ATS Crawl</h4>
          <p class="text-xs text-neutral-700">Dedicated workers query Ashby, Greenhouse, and Lever API endpoints directly every 24 hours.</p>
        </div>

        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
          <div class="font-mono text-xs font-black bg-black text-white px-2 py-0.5 inline-block mb-3">02 // NORMALIZE</div>
          <h4 class="font-black text-base mb-1">Data Cleansing & Deduplication</h4>
          <p class="text-xs text-neutral-700">Cleanse job descriptions, eliminate expired requisitions, and deduplicate multi-posted roles.</p>
        </div>

        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
          <div class="font-mono text-xs font-black bg-black text-white px-2 py-0.5 inline-block mb-3">03 // ANALYZE</div>
          <h4 class="font-black text-base mb-1">Surge Scoring & Analytics</h4>
          <p class="text-xs text-neutral-700">Calculate week-over-week headcount velocity, extract compensation bands, and score expansion intent.</p>
        </div>

        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
          <div class="font-mono text-xs font-black bg-black text-white px-2 py-0.5 inline-block mb-3">04 // DELIVER</div>
          <h4 class="font-black text-base mb-1">Weekly Intelligence Feed</h4>
          <p class="text-xs text-neutral-700">Structured CSV data feeds and executive briefing reports delivered straight to your inbox every Monday.</p>
        </div>

      </div>

    </div>
  </section>

  <!-- 6. Studio Collaboration & Inquiries -->
  <section class="py-16 px-4 bg-[#FEFFF0] border-t-3 border-black">
    <div class="max-w-4xl mx-auto bg-white border-3 border-black p-8 md:p-12 shadow-[8px_8px_0px_rgba(0,0,0,1)] text-center relative">
      <img src={svgPinkStar.src} alt="" width="65" class="absolute -top-8 -left-5 hidden sm:block" />

      <h3 class="text-3xl md:text-4xl font-black mb-3">
        Need Custom Data Analytics, Pipeline Strategy or Web Systems?
      </h3>
      <p class="text-neutral-700 text-sm md:text-base max-w-xl mx-auto mb-8 leading-relaxed">
        Whether you need automated crawler feeds across 500+ target companies, market analytics datasets, or full-stack web platforms built from scratch, let's collaborate.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href="mailto:suryasunrise261@gmail.com?subject=Data%20Analytics%20%26%20Strategy%20Inquiry" 
          class="bg-[var(--yellow)] hover:bg-[#ffe37d] text-black font-black text-base px-8 py-3.5 border-2 border-black shadow-[4px_4px_0px_rgba(0,0,0,1)] transition-all">
          Inquire Custom Analytics / Strategy →
        </a>

        <a 
          href="/products" 
          class="bg-white hover:bg-neutral-100 text-black font-bold text-sm px-6 py-3.5 border-2 border-black shadow-[2px_2px_0px_rgba(0,0,0,1)] transition-all">
          Browse All Products
        </a>

        <a 
          href="/profile" 
          class="bg-[var(--blue)] hover:bg-[#a1dcff] text-black font-bold text-sm px-6 py-3.5 border-2 border-black shadow-[2px_2px_0px_rgba(0,0,0,1)] transition-all">
          View Developer Profile
        </a>
      </div>

      <div class="mt-8 pt-4 border-t border-neutral-300">
      </div>
    </div>
  </section>

  <Footer />
</Layout>
