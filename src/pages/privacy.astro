---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro"
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import svgUnderline from '../assets/underline.svg'
import { author } from '../sample'

const pageTitle = "Privacy Policy | Jayasurya Data Studio";
const pageDesc = "Privacy policy and data protection practices for subscribers of Jayasurya Data Studio intelligence feeds and software products.";
const lastUpdated = "March 10, 2026";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      
      <!-- Top Tag & Header -->
      <div class="mb-12">
        <div class="inline-block bg-[var(--yellow)] px-3 py-1 text-xs font-black uppercase border-2 border-black mb-3">
          Legal & Compliance
        </div>
        <h1 class="text-4xl md:text-5xl font-black leading-tight">Privacy Policy</h1>
        <img src={svgUnderline.src} alt="" width="160" class="mt-2" />
        <p class="text-sm font-bold text-neutral-600 mt-3">
          Last Updated: {lastUpdated} · Effective Immediately
        </p>
      </div>

      <!-- Policy Content Card -->
      <div class="bg-white border-3 border-black p-6 md:p-10 shadow-[8px_8px_0px_rgba(0,0,0,1)] space-y-8 text-neutral-800 text-sm md:text-base leading-relaxed">
        
        <div>
          <h2 class="text-2xl font-black text-black mb-3">1. Overview & Scope</h2>
          <p>
            This Privacy Policy describes how <strong>Jayasurya Data Studio</strong> ("we", "our", or "us"), operated by {author.name} based in {author.location}, collects, uses, and protects your information when you visit <strong>jayasurya.digital</strong> or subscribe to our data intelligence feeds, reports, and software platforms.
          </p>
        </div>

        <hr class="border-neutral-300 border-dashed" />

        <div>
          <h2 class="text-2xl font-black text-black mb-3">2. Information We Collect</h2>
          <p class="mb-3">We collect minimal information necessary to deliver our services:</p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Subscriber Information:</strong> When you subscribe to our data feeds (such as the Engineering Hiring Surge Report), we collect your email address for delivering weekly reports and CSV datasets.</li>
            <li><strong>Billing & Payment Information:</strong> Payments are processed directly and securely through our payment partner, <strong>Dodo Payments</strong>. We do not store or process your full payment card details or CVV on our servers.</li>
            <li><strong>Inquiries & Communication:</strong> Information you voluntarily provide when contacting us via email for custom pipelines, support, or advisory services.</li>
            <li><strong>Technical & Usage Data:</strong> Standard server log information, including device type, browser, IP address, and anonymized aggregate page views to ensure site performance and security.</li>
          </ul>
        </div>

        <hr class="border-neutral-300 border-dashed" />

        <div>
          <h2 class="text-2xl font-black text-black mb-3">3. How We Use Your Information</h2>
          <ul class="list-disc pl-6 space-y-2">
            <li>To deliver weekly subscriber data feeds, CSV files, and market intelligence reports directly to your inbox.</li>
            <li>To manage your active subscription, process billing renewals, and provide customer support.</li>
            <li>To respond to custom data pipeline inquiries and technical advisory requests.</li>
            <li>To maintain website performance, prevent fraud, and comply with legal requirements.</li>
          </ul>
          <p class="mt-3 font-bold text-black">
            We will never sell, rent, or trade your personal data to third parties or marketing brokers.
          </p>
        </div>

        <hr class="border-neutral-300 border-dashed" />

        <div>
          <h2 class="text-2xl font-black text-black mb-3">4. Sourced Public Job & ATS Data</h2>
          <p>
            Our data feeds (such as the Engineering Hiring Surge Report) aggregate and structure publicly published job requisition data from official company ATS portals (Ashby, Greenhouse, Lever). This information is sourced strictly from public business endpoints for B2B market intelligence, hiring analytics, and recruiting research.
          </p>
        </div>

        <hr class="border-neutral-300 border-dashed" />

        <div>
          <h2 class="text-2xl font-black text-black mb-3">5. Third-Party Service Providers</h2>
          <p class="mb-3">We utilize trusted third-party services to operate our digital infrastructure:</p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Dodo Payments:</strong> Handles payment checkout, billing management, subscription recurring renewals, and invoice generation.</li>
            <li><strong>Cloud Hosting & CDN:</strong> Secures and delivers our static web assets globally.</li>
          </ul>
        </div>

        <hr class="border-neutral-300 border-dashed" />

        <div>
          <h2 class="text-2xl font-black text-black mb-3">6. Your Rights & Data Deletion</h2>
          <p>
            You have the right to access, correct, or request the complete deletion of your personal email or subscriber records at any time. To exercise these rights or request data erasure, simply email us at <a href={`mailto:${author.email}`} class="underline font-bold text-black">{author.email}</a>.
          </p>
        </div>

        <hr class="border-neutral-300 border-dashed" />

        <div>
          <h2 class="text-2xl font-black text-black mb-3">7. Contact Information</h2>
          <p>
            If you have any questions, concerns, or requests regarding this Privacy Policy, please reach out to:
          </p>
          <div class="mt-3 p-4 bg-[#FEFFF0] border-2 border-black space-y-1 font-mono text-sm">
            <div><strong>Entity:</strong> Jayasurya Data Studio</div>
            <div><strong>Founder:</strong> {author.name}</div>
            <div><strong>Email:</strong> <a href={`mailto:${author.email}`} class="underline font-bold">{author.email}</a></div>
            <div><strong>Location:</strong> {author.location}</div>
          </div>
        </div>

        <div class="pt-4 border-t border-neutral-300">
        </div>

      </div>

    </div>
  </section>

  <Footer />
</Layout>
