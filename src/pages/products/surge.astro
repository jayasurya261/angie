---
import '../../styles/global.css'
import Layout from "../../layouts/Layout.astro"
import Header from '../../components/Header.astro'
import ProductHero from '../../components/ProductHero.astro'
import SampleTable from '../../components/SampleTable.astro'
import PricingCard from '../../components/PricingCard.astro'
import FAQ from '../../components/FAQ.astro'
import Footer from '../../components/Footer.astro'
import Bars from '../../components/Bars.astro'
import svgUnderline from '../../assets/underline.svg'
import svgPinkStar from '../../assets/pink-star.svg'
import { products } from '../../data/products'

const product = products.find(p => p.slug === 'surge') || products[0];

const pageTitle = "Engineering Hiring Surge Report | Jayasurya Data Studio";
const pageDesc = "Weekly intelligence feed tracking sudden engineering hiring spikes across 90+ tech companies via direct Ashby, Greenhouse, and Lever ATS scrapers.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />

  <!-- 1. Hero Section -->
  <ProductHero />

  <!-- 2. What You Get / Data Specification Section -->
  <section class="py-16 px-4 bg-[#f8f9eb] border-y-3 border-black">
    <div class="max-w-5xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-block bg-[var(--yellow)] px-3 py-1 text-xs font-black uppercase border-2 border-black mb-3">
          Inside the Feed
        </div>
        <h2 class="text-3xl md:text-5xl font-black">What You Get Every Monday</h2>
        <p class="text-neutral-700 mt-2 text-md">
          A structured, unopinionated intelligence package engineered for immediate action in your outreach or recruiting CRM.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-[var(--blue)] border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-radar-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">100% Direct ATS Feeds</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Harvested directly from official Ashby, Greenhouse, and Lever endpoints. Never scraped from LinkedIn or third-party aggregators.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200 text-[11px] font-bold text-neutral-500 uppercase">
            Zero Ghost Jobs
          </div>
        </div>

        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-[var(--yellow)] border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-calendar-check-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">Monday 8:00 AM Delivery</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Automated pipelines run Sunday night and land in your inbox Monday morning before hiring managers begin their work week.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200 text-[11px] font-bold text-neutral-500 uppercase">
            Weekly Freshness
          </div>
        </div>

        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-emerald-200 border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-table-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">Clean Standardized CSV</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Normalized fields: Company, Role Title, Department, Location (Remote/Onsite), Salary Range, ATS Source, Direct Application Link.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200 text-[11px] font-bold text-neutral-500 uppercase">
            Ready for CRM Import
          </div>
        </div>

        <div class="bg-white border-2 border-black p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="size-10 bg-purple-200 border-2 border-black flex items-center justify-center font-bold text-lg mb-3">
              <i class="ri-flashlight-line"></i>
            </div>
            <h3 class="font-black text-lg mb-2">Surge Velocity Signals</h3>
            <p class="text-xs text-neutral-700 leading-relaxed">
              Track net new hiring spikes (+4, +6 roles in a week) signaling newly funded teams or rapid engineering expansion.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200 text-[11px] font-bold text-neutral-500 uppercase">
            Headcount Velocity
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. Live Sample Data Section -->
  <SampleTable />

  <!-- 4. Who It's For Section -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12 relative">
        <div class="inline-block bg-[var(--blue)] px-3 py-1 text-xs font-black uppercase border-2 border-black mb-3">
          Built For Speed
        </div>
        <h2 class="text-3xl md:text-5xl font-black">Who Relies on This Feed</h2>
        <p class="text-neutral-700 mt-2 text-md">
          Designed for teams whose revenue depends on reaching hiring companies first.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-white border-3 border-black p-6 shadow-[6px_6px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="inline-block bg-black text-white text-xs font-mono font-bold px-2 py-0.5 mb-3">
              01 // STAFFING
            </div>
            <h3 class="font-black text-xl mb-2">Staffing & Headhunting Agencies</h3>
            <p class="text-sm text-neutral-700 leading-relaxed">
              Find fast-growing engineering orgs with sudden hiring spikes before other agencies reach their VP of Engineering or Talent leads.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200 text-xs font-bold text-emerald-700">
            ✓ Outbound pipeline intelligence
          </div>
        </div>

        <div class="bg-white border-3 border-black p-6 shadow-[6px_6px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="inline-block bg-black text-white text-xs font-mono font-bold px-2 py-0.5 mb-3">
              02 // SOURCING
            </div>
            <h3 class="font-black text-xl mb-2">Talent Leads & In-house Sourcers</h3>
            <p class="text-sm text-neutral-700 leading-relaxed">
              Monitor which tech hubs and tech stacks are heating up, benchmark competitive compensation packages, and spot candidate movement.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200 text-xs font-bold text-emerald-700">
            ✓ Competitive talent mapping
          </div>
        </div>

        <div class="bg-white border-3 border-black p-6 shadow-[6px_6px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
          <div>
            <div class="inline-block bg-black text-white text-xs font-mono font-bold px-2 py-0.5 mb-3">
              03 // RESEARCH
            </div>
            <h3 class="font-black text-xl mb-2">B2B SaaS Founders & GTM Teams</h3>
            <p class="text-sm text-neutral-700 leading-relaxed">
              Companies hiring 5+ backend or AI engineers are currently scaling infrastructure and purchasing developer tools and cloud services.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-200 text-xs font-bold text-emerald-700">
            ✓ High-intent buyer intent signals
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. Pricing Section -->
  <PricingCard />

  <!-- 6. FAQ Section -->
  <FAQ />

  <!-- 7. Final Action Callout -->
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto bg-white border-3 border-black p-8 md:p-10 shadow-[8px_8px_0px_rgba(0,0,0,1)] text-center relative">
      <img src={svgPinkStar.src} alt="" width="60" class="absolute -top-7 -left-5 hidden sm:block" />
      
      <h3 class="text-2xl md:text-3xl font-black mb-3">
        Ready for Monday Morning Intel?
      </h3>
      <p class="text-neutral-700 text-sm md:text-base max-w-lg mx-auto mb-6">
        Subscribe now to get this week's full 140+ role dataset delivered directly to your inbox with direct links and salary ranges.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href={product.dodoLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-[var(--yellow)] hover:bg-[#ffe37d] text-black font-black text-base px-8 py-3.5 border-2 border-black shadow-[4px_4px_0px_rgba(0,0,0,1)] transition-all">
          Subscribe for ${product.price}/mo →
        </a>
      </div>

      <div class="mt-6 pt-4 border-t border-neutral-300">
        <Bars />
      </div>
    </div>
  </section>

  <Footer />
</Layout>
