---
import '../../styles/global.css'
import Layout from "../../layouts/Layout.astro"
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import Bars from '../../components/Bars.astro'
import svgUnderline from '../../assets/underline.svg'
import svgRedStar from '../../assets/red-star.svg'
import { products } from '../../data/products'

const pageTitle = "Data Intelligence Products & Reports | Jayasurya Data Studio";
const pageDesc = "Curated market intelligence feeds, engineering hiring surge data, and salary benchmarks powered by direct ATS crawler pipelines.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />

  <section class="py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-14 relative">
        <div class="inline-flex items-center gap-2 bg-black text-white px-3 py-1 text-xs font-black uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-[var(--yellow)]"></span>
          <span>Data Studio Products</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-black leading-tight">
          <span>Direct Market Intelligence</span><br>
          <span class="relative inline-block mt-1">
            <span class="absolute bg-[var(--yellow)] w-full h-[40%] left-0 bottom-1 z-0"></span>
            <span class="relative z-10">Data Products</span>
          </span>
        </h1>
        <img src={svgUnderline.src} alt="" width="160" class="mt-2" />

        <p class="text-lg text-neutral-700 mt-4 leading-relaxed">
          We operate automated crawler infrastructure across 90+ top tech companies, monitoring Ashby, Greenhouse, and Lever pipelines to deliver verified data feeds for staffing agencies, investors, and talent leads.
        </p>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {products.map(product => (
          <div class={`bg-white border-3 border-black p-6 shadow-[8px_8px_0px_rgba(0,0,0,1)] flex flex-col justify-between relative ${product.status === 'live' ? 'ring-2 ring-black' : 'opacity-90'}`}>
            
            <div>
              <!-- Status & Price Header -->
              <div class="flex items-center justify-between border-b-2 border-black pb-3 mb-4">
                <span class={`text-xs font-black px-2 py-0.5 border border-black ${
                  product.status === 'live' 
                    ? 'bg-[var(--yellow)] text-black' 
                    : 'bg-neutral-200 text-neutral-700'
                }`}>
                  {product.badge}
                </span>
                <span class="font-mono text-sm font-bold text-neutral-800">
                  ${product.price} / {product.interval}
                </span>
              </div>

              <!-- Title & Tagline -->
              <h2 class="text-2xl font-black mb-2 leading-snug">{product.name}</h2>
              <p class="text-xs font-bold text-neutral-600 mb-4">{product.tagline}</p>
              <p class="text-xs text-neutral-700 leading-relaxed mb-4">{product.description}</p>

              <!-- Cadence & Coverage Pills -->
              <div class="bg-[#FEFFF0] border border-black p-3 space-y-1.5 text-xs mb-4">
                <div class="flex items-center gap-1.5 font-bold text-neutral-800">
                  <i class="ri-radar-fill text-neutral-600"></i>
                  <span>{product.coverage}</span>
                </div>
                <div class="flex items-center gap-1.5 text-neutral-600">
                  <i class="ri-time-line text-neutral-500"></i>
                  <span>{product.cadence}</span>
                </div>
              </div>

              <!-- Highlights -->
              <ul class="space-y-2 text-xs text-neutral-700 mb-6">
                {product.highlights.slice(0, 3).map(h => (
                  <li class="flex items-start gap-1.5">
                    <i class="ri-check-line font-bold text-emerald-600 shrink-0"></i>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Card Bottom Action -->
            <div class="pt-4 border-t-2 border-black">
              {product.status === 'live' ? (
                <a 
                  href={`/products/${product.slug}`} 
                  class="w-full bg-[var(--yellow)] hover:bg-[#ffe37d] text-black font-black text-sm py-3 px-4 border-2 border-black shadow-[3px_3px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-center gap-2">
                  <span>View Report & Sample Data</span>
                  <i class="ri-arrow-right-line"></i>
                </a>
              ) : (
                <a 
                  href={product.dodoLink} 
                  class="w-full bg-neutral-100 hover:bg-neutral-200 text-neutral-800 font-bold text-xs py-2.5 px-3 border border-black text-center block transition-all">
                  Join Early Access Waitlist →
                </a>
              )}
            </div>

          </div>
        ))}
      </div>

      <!-- Studio Philosophy Banner -->
      <div class="mt-16 bg-[#FEFFF0] border-3 border-black p-8 shadow-[8px_8px_0px_rgba(0,0,0,1)]">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
          <div class="md:col-span-2 space-y-2">
            <h3 class="text-2xl font-black">Need a Custom Scraping Pipeline or Dedicated Dataset?</h3>
            <p class="text-sm text-neutral-700 leading-relaxed">
              If your recruiting team or fund requires custom tracking across 500+ specific target companies, private API exports, or weekly webhook integrations, we build bespoke data pipelines on demand.
            </p>
          </div>
          <div class="text-center md:text-right">
            <a 
              href="/inquire" 
              class="inline-block bg-[var(--blue)] hover:bg-[#a5dcff] text-black font-black text-sm px-6 py-3.5 border-2 border-black shadow-[4px_4px_0px_rgba(0,0,0,1)] transition-all">
              Request Custom Feed →
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
