---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro"
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Tools from '../components/Tools.astro'
import Footer from '../components/Footer.astro'
import CallToAction from '../components/CallToAction.astro'
import Works from '../components/Works.astro'
import Service from '../components/Service.astro'
import Bars from '../components/Bars.astro'

const pageTitle = "Jayasurya | Full Stack Engineer & Data Systems Developer";
const pageDesc = "Computer Science undergraduate and Full Stack Engineer building scalable web apps, direct ATS crawler pipelines, and data products.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />
  
  <Hero />
  
  <Tools />
  
  <Service />
  
  <Works />

  <!-- Data Studio Callout on Profile -->
  <section class="py-12 px-4">
    <div class="max-w-4xl mx-auto bg-white border-3 border-black p-8 shadow-[8px_8px_0px_rgba(0,0,0,1)]">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2">
          <div class="inline-block bg-[var(--yellow)] px-2 py-0.5 text-xs font-black uppercase border border-black">
            Commercial Data Studio
          </div>
          <h3 class="text-2xl font-black">Building Independent Market Intelligence Feeds</h3>
          <p class="text-sm text-neutral-700 leading-relaxed max-w-xl">
            Beyond engineering client and full-stack web applications, I operate automated crawler pipelines tracking 90+ top tech companies.
          </p>
        </div>
        <a 
          href="/" 
          class="bg-[var(--yellow)] hover:bg-[#ffe37d] text-black font-black text-sm px-6 py-3.5 border-2 border-black shadow-[4px_4px_0px_rgba(0,0,0,1)] transition-all shrink-0">
          Visit Data Studio →
        </a>
      </div>
      <div class="mt-4 pt-3 border-t border-neutral-200">
        <Bars />
      </div>
    </div>
  </section>

  <CallToAction />
  
  <Footer />
</Layout>
